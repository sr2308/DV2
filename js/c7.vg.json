{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Australia's seafood exports go",
    "subtitle": "Seafood exports by destination. Line width = value.",
    "anchor": "start"
  },
  "width": "container",
  "height": 340,
  "params": [
    {
      "name": "year",
      "value": 2019,
      "bind": {"input": "range", "min": 1990, "max": 2025, "step": 1, "name": "Financial year: "}
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": [-150, 0, 0],
    "fit": {
      "type": "Feature",
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [[98, 46], [-100, 46], [98, -48], [-100, -48]]
      }
    }
  },
  "layer": [
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "rect",
        "x": 0,
        "y": 0,
        "x2": {"expr": "width"},
        "y2": {"expr": "height"},
        "fill": "#D5E6EA",
        "cornerRadius": 4
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F6F3EC",
        "stroke": "#D5E6EA",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {"url": "data/c7_exports_by_country.csv"},
      "transform": [
        {
          "fold": [
            "1989–90", "1990–91", "1991–92", "1992–93", "1993–94", "1994–95", "1995–96", "1996–97",
            "1997–98", "1998–99", "1999–00", "2000–01", "2001–02", "2002–03", "2003–04", "2004–05",
            "2005–06", "2006–07", "2007–08", "2008–09", "2009–10", "2010–11", "2011–12", "2012–13",
            "2013–14", "2014–15", "2015–16", "2016–17", "2017–18", "2018–19", "2019–20", "2020–21",
            "2021–22", "2022–23", "2023–24", "2024–25"
          ],
          "as": ["year", "value_m"]
        },
        {"calculate": "toNumber(datum.value_m)", "as": "export_musd"},
        {"calculate": "toNumber(substring(datum.year, 0, 4)) + 1", "as": "year_end"},
        {"filter": "datum.year_end == year"},
        {
          "lookup": "country",
          "from": {
            "data": {"url": "data/export_destinations.csv"},
            "key": "country",
            "fields": ["lat", "lon"]
          }
        },
        {"calculate": "toNumber(datum.lon)", "as": "lon"},
        {"calculate": "toNumber(datum.lat)", "as": "lat"},
        {"calculate": "133.78", "as": "o_lon"},
        {"calculate": "-25.27", "as": "o_lat"},
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "export_musd", "order": "descending"}]
        },
        {
          "calculate": "datum.rank + '  ' + datum.country + '  $' + format(datum.export_musd, ',.0f') + 'M'",
          "as": "row"
        },
        {
          "calculate": "datum.lon + (({'China':0.01,'Japan':3,'Taiwan':3,'Hong Kong':3,'Vietnam':2.5,'Singapore':3,'United States':-3})[datum.country] || 3)",
          "as": "label_lon"
        },
        {
          "calculate": "datum.lat + (({'China':3.5,'Japan':1,'Taiwan':2,'Hong Kong':-4,'Vietnam':-3,'Singapore':2,'United States':3})[datum.country] || 0)",
          "as": "label_lat"
        },
        {
          "calculate": "({'China':'center','Japan':'left','Taiwan':'left','Hong Kong':'left','Vietnam':'left','Singapore':'left','United States':'right'})[datum.country] || 'left'",
          "as": "label_side"
        }
      ],
      "layer": [
        {
          "mark": {"type": "rule", "color": "#D85A30", "opacity": 0.7, "strokeCap": "round"},
          "encoding": {
            "longitude": {"field": "o_lon", "type": "quantitative"},
            "latitude": {"field": "o_lat", "type": "quantitative"},
            "longitude2": {"field": "lon"},
            "latitude2": {"field": "lat"},
            "strokeWidth": {
              "field": "export_musd",
              "type": "quantitative",
              "scale": {"domain": [0, 900], "range": [0.5, 14]},
              "legend": null
            },
            "tooltip": [
              {"field": "country", "title": "Destination"},
              {"field": "year", "title": "Year"},
              {"field": "export_musd", "title": "Exports ($M)", "format": ",.0f"}
            ]
          }
        },
        {
          "mark": {"type": "circle", "color": "#1f2a30", "size": 30},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "tooltip": [
              {"field": "country", "title": "Destination"},
              {"field": "year", "title": "Year"},
              {"field": "export_musd", "title": "Exports ($M)", "format": ",.0f"}
            ]
          }
        },
        {
          "transform": [{"filter": "datum.rank <= 5"}],
          "mark": {
            "type": "text",
            "fontSize": {"expr": "width < 500 ? 10 : 12"},
            "fontWeight": "bold",
            "color": "#1f2a30",
            "baseline": "middle",
            "align": {"expr": "datum.label_side"},
            "stroke": "#D5E6EA",
            "strokeWidth": 4,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {"field": "label_lon", "type": "quantitative"},
            "latitude": {"field": "label_lat", "type": "quantitative"},
            "text": {"field": "country"}
          }
        },
        {
          "transform": [{"filter": "datum.rank <= 5"}],
          "mark": {
            "type": "text",
            "fontSize": {"expr": "width < 500 ? 10 : 12"},
            "fontWeight": "bold",
            "color": "#1f2a30",
            "baseline": "middle",
            "align": {"expr": "datum.label_side"}
          },
          "encoding": {
            "longitude": {"field": "label_lon", "type": "quantitative"},
            "latitude": {"field": "label_lat", "type": "quantitative"},
            "text": {"field": "country"}
          }
        },
        {
          "transform": [{"filter": "datum.rank <= 5"}],
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": {"expr": "width < 500 ? 10 : 12"},
            "color": "#1f2a30",
            "dy": {"expr": "datum.rank * (width < 500 ? 14 : 19) + (width < 500 ? 8 : 14)"}
          },
          "encoding": {
            "longitude": {"datum": -172},
            "latitude": {"datum": -4},
            "text": {"field": "row"}
          }
        }
      ]
    },
    {
      "data": {"values": [{"lon": 133.78, "lat": -25.27}]},
      "mark": {"type": "circle", "color": "#0072B2", "size": 120},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    },
    {
      "data": {"values": [{"lon": -172, "lat": -4}]},
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "fontSize": {"expr": "width < 500 ? 20 : 30"},
            "fontWeight": "bold",
            "color": "#0c3b55",
            "text": {"expr": "(year - 1) + '-' + substring(year + '', 2, 4)"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "dy": {"expr": "width < 500 ? 12 : 16"},
            "fontSize": {"expr": "width < 500 ? 10 : 12"},
            "fontWeight": "bold",
            "color": "#4A6470",
            "text": "Top 5 buyers"
          }
        }
      ],
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}