{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Rock lobster goes overseas, oysters stay here",
    "subtitle": [
      "Export share: rough % of production volume sold overseas, 2023-24.",
      "Circle size = production value ($50M to $1.3B)."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 346,
  "data": {"url": "data/c8_production_exports_2023_24.csv"},
  "transform": [
    {"calculate": "datum.species == 'Salmonids' ? 'Salmon' : datum.species", "as": "species"},
    {
      "calculate": "toNumber(datum.wild_production_t) + toNumber(datum.farmed_production_t)",
      "as": "production_t"
    },
    {
      "calculate": "(toNumber(datum.wild_production_value_000) + toNumber(datum.farmed_production_value_000)) / 1000",
      "as": "value_musd"
    },
    {
      "calculate": "min(100, toNumber(datum.export_t) / datum.production_t * 100)",
      "as": "export_pct"
    },
    {
      "calculate": "toNumber(datum.farmed_production_t) > toNumber(datum.wild_production_t) ? 'Mostly farmed' : 'Mostly wild-caught'",
      "as": "type"
    },
    {"calculate": "datum.species + ' ~' + format(datum.export_pct, '.0f') + '%'", "as": "label"}
  ],
  "layer": [
    {
      "data": {"values": [{"y": 50}]},
      "mark": {"type": "rule", "strokeDash": [4, 3], "color": "#999"},
      "encoding": {"y": {"field": "y", "type": "quantitative"}}
    },
    {
      "data": {"values": [{"y": 50, "t": "Half exported"}]},
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -6,
        "x": {"expr": "width"},
        "fontSize": 10,
        "color": "#777"
      },
      "encoding": {"y": {"field": "y", "type": "quantitative"}, "text": {"field": "t"}}
    },
    {
      "mark": {"type": "circle", "opacity": 0.8, "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "x": {
          "field": "production_t",
          "type": "quantitative",
          "scale": {"type": "log", "domain": [1000, 100000]},
          "title": "Tonnes produced per year (log scale)",
          "axis": {"format": "~s", "values": [1000, 3000, 10000, 30000, 100000], "grid": false}
        },
        "y": {
          "field": "export_pct",
          "type": "quantitative",
          "scale": {"domain": [0, 100]},
          "title": "% exported (estimate)",
          "axis": {"format": ".0f"}
        },
        "size": {
          "field": "value_musd",
          "type": "quantitative",
          "scale": {"range": [60, 2500]},
          "legend": null
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": ["Mostly farmed", "Mostly wild-caught"],
            "range": ["#0072B2", "#D85A30"]
          },
          "legend": {"title": null, "orient": "top", "direction": "horizontal", "offset": 8}
        },
        "tooltip": [
          {"field": "species", "title": "Species"},
          {"field": "production_t", "title": "Produced (t)", "format": ",.0f"},
          {"field": "export_t", "title": "Exported (t)", "format": ",.0f"},
          {"field": "export_pct", "title": "% exported (estimate)", "format": ".0f"},
          {"field": "value_musd", "title": "Value ($M)", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {"expr": "datum.species == 'Salmon' ? 'right' : 'left'"},
        "dx": {"expr": "datum.species == 'Salmon' ? 28 : 12"},
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1f2a30",
        "dy": {"expr": "datum.species == 'Salmon' ? -36 : 0"}
      },
      "encoding": {
        "x": {
          "field": "production_t",
          "type": "quantitative",
          "scale": {"type": "log", "domain": [1000, 100000]}
        },
        "y": {"field": "export_pct", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}