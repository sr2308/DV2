{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Salmon grew bigger and far more valuable",
    "subtitle": "Each dot is one year, 1999-2024. Right = more tonnes, up = more value.",
    "anchor": "start"
  },
  "width": "container",
  "height": 300,
  "data": {"url": "data/c6_species_value_quantity_by_year.csv"},
  "transform": [
    {
      "fold": [
        "1998–99", "1999–00", "2000–01", "2001–02", "2002–03", "2003–04", "2004–05", "2005–06",
        "2006–07", "2007–08", "2008–09", "2009–10", "2010–11", "2011–12", "2012–13", "2013–14",
        "2014–15", "2015–16", "2016–17", "2017–18", "2018–19", "2019–20", "2020–21", "2021–22",
        "2022–23", "2023–24"
      ],
      "as": ["year", "amount"]
    },
    {"calculate": "toNumber(datum.amount)", "as": "amount"},
    {
      "aggregate": [{"op": "sum", "field": "amount", "as": "amount"}],
      "groupby": ["species", "measure", "year"]
    },
    {"pivot": "measure", "value": "amount", "groupby": ["species", "year"]},
    {"calculate": "datum.value_000 / 1000", "as": "value_musd"},
    {
      "calculate": "datum.species == 'Salmonids' ? 'Salmon & trout' : datum.species",
      "as": "species_name"
    },
    {"calculate": "toNumber(substring(datum.year, 0, 4)) + 1", "as": "year_end"}
  ],
  "encoding": {
    "x": {
      "field": "quantity_t",
      "type": "quantitative",
      "title": "Tonnes per year",
      "axis": {"format": "~s", "grid": false}
    },
    "y": {
      "field": "value_musd",
      "type": "quantitative",
      "title": "Value ($M)",
      "axis": {"format": ",.0f"}
    },
    "color": {
      "field": "species_name",
      "type": "nominal",
      "scale": {
        "domain": ["Salmon & trout", "Rock lobster", "Prawns"],
        "range": ["#1D9E75", "#D85A30", "#7F77DD"]
      },
      "legend": {"orient": "top-left", "title": "Click to highlight"}
    },
    "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.15}
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 2}, "encoding": {"order": {"field": "year_end"}}},
    {
      "mark": {"type": "point", "filled": true, "size": 30},
      "encoding": {
        "tooltip": [
          {"field": "species_name", "title": "Species"},
          {"field": "year", "title": "Year"},
          {"field": "quantity_t", "title": "Tonnes", "format": ",.0f"},
          {"field": "value_musd", "title": "Value ($M)", "format": ",.0f"}
        ]
      },
      "params": [{"name": "pick", "select": {"type": "point", "fields": ["species_name"]}, "bind": "legend"}]
    },
    {
      "transform": [{"filter": "datum.year == '1998–99' || datum.year == '2023–24'"}],
      "mark": {"type": "text", "dx": 8, "align": "left", "fontSize": 10, "fontWeight": "bold"},
      "encoding": {"text": {"field": "year_end"}}
    }
  ],
  "config": {"view": {"stroke": null}}
}