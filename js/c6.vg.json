{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Salmon grew bigger and far more valuable",
    "subtitle": "Change since 1998-99 for three species. 1× = the 1998-99 level, 2× = double.",
    "anchor": "start"
  },
  "data": {"url": "data/c6_species_value_quantity_by_year.csv"},
  "transform": [
    {
      "fold": [
        "1998–99", "1998-99", "1999–00", "1999-00", "2000–01", "2000-01", "2001–02", "2001-02",
        "2002–03", "2002-03", "2003–04", "2003-04", "2004–05", "2004-05", "2005–06", "2005-06",
        "2006–07", "2006-07", "2007–08", "2007-08", "2008–09", "2008-09", "2009–10", "2009-10",
        "2010–11", "2010-11", "2011–12", "2011-12", "2012–13", "2012-13", "2013–14", "2013-14",
        "2014–15", "2014-15", "2015–16", "2015-16", "2016–17", "2016-17", "2017–18", "2017-18",
        "2018–19", "2018-19", "2019–20", "2019-20", "2020–21", "2020-21", "2021–22", "2021-22",
        "2022–23", "2022-23", "2023–24", "2023-24"
      ],
      "as": ["year_key", "amount"]
    },
    {"filter": "isValid(datum.amount) && datum.amount !== ''"},
    {"calculate": "toNumber(substring(datum.year_key, 0, 4)) + 1", "as": "year_end"},
    {"calculate": "toNumber(datum.amount)", "as": "amount"},
    {
      "aggregate": [{"op": "sum", "field": "amount", "as": "amount"}],
      "groupby": ["species", "measure", "year_end"]
    },
    {
      "window": [{"op": "first_value", "field": "amount", "as": "base"}],
      "groupby": ["species", "measure"],
      "sort": [{"field": "year_end"}],
      "frame": [null, null]
    },
    {"calculate": "datum.amount / datum.base", "as": "index"},
    {
      "calculate": "datum.measure == 'value_000' ? 'Value' : 'Production (tonnes)'",
      "as": "measure_label"
    },
    {
      "calculate": "datum.species == 'Salmonids' ? 'Salmon & trout' : datum.species",
      "as": "species_name"
    },
    {
      "calculate": "datum.index >= 2 ? format(datum.index, '.1f') + ' times' : format(datum.index - 1, '+.0%')",
      "as": "change_label"
    }
  ],
  "facet": {
    "row": {
      "field": "measure_label",
      "type": "nominal",
      "sort": ["Production (tonnes)", "Value"],
      "title": null,
      "header": {"labels": false, "title": null, "labelPadding": 0, "titlePadding": 0}
    }
  },
  "spacing": 18,
  "spec": {
    "width": 345,
    "height": 136,
    "encoding": {
      "x": {
        "field": "year_end",
        "type": "quantitative",
        "title": null,
        "scale": {"domain": [1999, 2024]},
        "axis": {"format": "d", "values": [1999, 2004, 2009, 2014, 2019, 2024], "grid": false}
      },
      "y": {
        "field": "index",
        "type": "quantitative",
        "title": null,
        "scale": {"type": "log", "domain": [0.5, 20], "nice": false},
        "axis": {
          "values": [1, 2, 5, 10, 20],
          "labelExpr": "datum.value == 1 ? 'no change' : datum.value + '×'",
          "grid": true
        }
      },
      "color": {
        "field": "species_name",
        "type": "nominal",
        "legend": {
          "orient": "top",
          "title": null,
          "direction": "horizontal",
          "symbolType": "stroke",
          "symbolStrokeWidth": 3,
          "offset": 1
        },
        "scale": {
          "domain": ["Salmon & trout", "Rock lobster", "Prawns"],
          "range": ["#0072B2", "#D85A30", "#9a9890"]
        }
      }
    },
    "layer": [
      {
        "transform": [{"filter": "datum.year_end == 1999 && datum.species == 'Salmonids'"}],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 13,
          "fontWeight": "bold",
          "color": "#0F2530",
          "x": 0,
          "y": 0
        },
        "encoding": {
          "text": {"field": "measure_label"},
          "color": {"value": "#0F2530"},
          "x": {"value": 0},
          "y": {"value": 0}
        }
      },
      {
        "data": {"values": [{"y": 1}]},
        "mark": {"type": "rule", "color": "#4A6470", "strokeDash": [3, 3]},
        "encoding": {"y": {"field": "y", "type": "quantitative"}}
      },
      {
        "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"},
        "encoding": {
          "tooltip": [
            {"field": "species_name", "title": "Species"},
            {"field": "year_end", "title": "Year ending"},
            {"field": "change_label", "title": "Change since 1998-99"}
          ]
        }
      },
      {"transform": [{"filter": "datum.year_end == 2024"}], "mark": {"type": "circle", "size": 45}},
      {
        "transform": [{"filter": "datum.year_end == 2024"}],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 7,
          "dy": {
            "expr": "datum.species == 'Salmonids' ? -5 : (datum.species == 'Prawns') == (datum.measure_label == 'Value') ? 8 : -6"
          },
          "fontSize": 12,
          "fontWeight": "bold"
        },
        "encoding": {"text": {"field": "change_label"}}
      }
    ]
  },
  "config": {"view": {"stroke": null}}
}