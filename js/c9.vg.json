{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A trade ban cut lobster exports by almost a third",
    "subtitle": "Value of Australian rock lobster exports, $M per year.",
    "anchor": "start"
  },
  "padding": {"left": 0, "right": 14, "top": 0, "bottom": 4},
  "width": "container",
  "height": 346,
  "layer": [
    {
      "data": {
        "values": [
          {"x": 2020.9, "x2": 2025, "fill": "#D85A30", "op": 0.1},
          {"x": 2025, "x2": 2031, "fill": "#4A6470", "op": 0.08}
        ]
      },
      "mark": {"type": "rect"},
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [1990, 2031]},
          "axis": {"format": "d", "grid": false, "tickCount": 8, "labelFlush": true},
          "title": "Financial year (ending)"
        },
        "x2": {"field": "x2"},
        "fill": {"field": "fill", "type": "nominal", "scale": null},
        "opacity": {"field": "op", "type": "quantitative", "scale": null}
      }
    },
    {
      "data": {"values": [{"x": 2028, "t": "Forecast", "c": "#4A6470"}]},
      "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "baseline": "top", "y": 4},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [1990, 2031]}},
        "text": {"field": "t"},
        "color": {"field": "c", "type": "nominal", "scale": null}
      }
    },
    {
      "data": {"url": "data/c9_rock_lobster_exports_by_year.csv"},
      "transform": [
        {
          "fold": [
            "1989–90", "1990–91", "1991–92", "1992–93", "1993–94", "1994–95", "1995–96", "1996–97",
            "1997–98", "1998–99", "1999–00", "2000–01", "2001–02", "2002–03", "2003–04", "2004–05",
            "2005–06", "2006–07", "2007–08", "2008–09", "2009–10", "2010–11", "2011–12", "2012–13",
            "2013–14", "2014–15", "2015–16", "2016–17", "2017–18", "2018–19", "2019–20", "2020–21",
            "2021–22", "2022–23", "2023–24", "2024–25"
          ],
          "as": ["year", "value_000"]
        },
        {"calculate": "toNumber(datum.value_000) / 1000", "as": "export_musd"},
        {"calculate": "toNumber(substring(datum.year, 0, 4)) + 1", "as": "year_end"}
      ],
      "layer": [
        {
          "mark": {"type": "line", "color": "#D85A30", "strokeWidth": 2.5},
          "encoding": {
            "strokeDash": {
              "datum": "Actual",
              "scale": {"domain": ["Actual", "ABARES forecast"], "range": [[1, 0], [5, 4]]},
              "legend": {
                "title": null,
                "orient": "top",
                "direction": "horizontal",
                "symbolType": "stroke",
                "symbolStrokeColor": "#D85A30",
                "symbolStrokeWidth": 2.5,
                "symbolSize": 300,
                "offset": 8
              }
            }
          }
        },
        {
          "mark": {"type": "point", "filled": true, "color": "#D85A30", "size": 20},
          "encoding": {
            "tooltip": [
              {"field": "year", "title": "Year"},
              {"field": "export_musd", "title": "Exports ($M)", "format": ",.0f"}
            ]
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "quantitative",
          "title": "Financial year (ending)",
          "scale": {"domain": [1990, 2031]},
          "axis": {"format": "d", "grid": false, "tickCount": 8, "labelFlush": true}
        },
        "y": {
          "field": "export_musd",
          "type": "quantitative",
          "title": "Exports ($M)",
          "scale": {"domain": [0, 1000]},
          "axis": {"format": ",.0f", "tickCount": 5}
        }
      }
    },
    {
      "data": {"url": "data/c9_rock_lobster_exports_forecast.csv"},
      "transform": [
        {
          "fold": ["2024–25", "2025–26", "2026–27", "2027–28", "2028–29", "2029–30", "2030–31"],
          "as": ["year", "value_m"]
        },
        {"calculate": "toNumber(datum.value_m)", "as": "export_musd"},
        {"calculate": "toNumber(substring(datum.year, 0, 4)) + 1", "as": "year_end"}
      ],
      "mark": {"type": "line", "color": "#D85A30", "strokeWidth": 2, "opacity": 0.9},
      "encoding": {
        "x": {
          "field": "year_end",
          "type": "quantitative",
          "title": "Financial year (ending)",
          "scale": {"domain": [1990, 2031]},
          "axis": {"format": "d", "grid": false, "tickCount": 8, "labelFlush": true}
        },
        "y": {
          "field": "export_musd",
          "type": "quantitative",
          "title": "Exports ($M)",
          "scale": {"domain": [0, 1000]},
          "axis": {"format": ",.0f", "tickCount": 5}
        },
        "tooltip": [
          {"field": "year", "title": "Year (forecast)"},
          {"field": "export_musd", "title": "Exports ($M)", "format": ",.0f"}
        ],
        "strokeDash": {
          "datum": "ABARES forecast",
          "scale": {"domain": ["Actual", "ABARES forecast"], "range": [[1, 0], [5, 4]]},
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeColor": "#D85A30",
            "symbolStrokeWidth": 2.5,
            "symbolSize": 300,
            "offset": 8
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {"x": 2020.9, "y": 900, "t": "China bans live lobster"},
          {"x": 2020.9, "y": 860, "t": "Nov 2020 to Dec 2024 (shaded)"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1f2a30"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [1990, 2031]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [0, 1000]}},
        "text": {"field": "t"}
      }
    },
    {
      "data": {"values": [{"x": 2031, "y": 869, "t": "$869M"}]},
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#D85A30"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [1990, 2031]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [0, 1000]}},
        "text": {"field": "t"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}